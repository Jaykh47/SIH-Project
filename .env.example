# Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to Git

# ─── Application ───────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# ─── Database ──────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=landstack
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# ─── Authentication ────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_min_32_chars
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# ─── AI Service ────────────────────────────────
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=dev-ai-service-key

# ─── Satellite / GIS (Optional) ────────────────
# SENTINEL_HUB_CLIENT_ID=
# SENTINEL_HUB_CLIENT_SECRET=
# GOOGLE_EARTH_ENGINE_SERVICE_ACCOUNT=

# ─── File Storage ──────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# ─── Rate Limiting ─────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ─── Logging ───────────────────────────────────
LOG_LEVEL=debug

# ─── Python / AI Service (set in ai-service/) ──
# AI_DB_HOST=localhost
# AI_DB_PORT=5432
# AI_DB_NAME=landstack
# AI_DB_USER=postgres
# AI_DB_PASSWORD=your_postgres_password_here
