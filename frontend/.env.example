# LandStack Frontend Environment Variables
# Copy to .env.local or .env for custom configuration

# API URL:
# For local dev with Vite proxy: leave blank (requests to /api will proxy to http://localhost:3001)
# For production deployment (e.g. Vercel): set to your deployed backend URL:
# VITE_API_URL=https://landstack-api.onrender.com/api
VITE_API_URL=
