# LandStack Backend Environment Configuration
# Copy this file to backend/.env and fill in your values

NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:5173

# Database (PostgreSQL with PostGIS)
# For local development:
DB_HOST=localhost
DB_PORT=5432
DB_NAME=landstack
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# For cloud database (e.g. Supabase):
# DB_HOST=aws-0-ap-south-1.pooler.supabase.com
# DB_PORT=5432 # or 6543
# DB_NAME=postgres
# DB_USER=postgres.your-project-ref
# DB_PASSWORD=your_password
# DB_SSL=true

# Authentication
JWT_SECRET=landstack_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=24h
BCRYPT_ROUNDS=12

# Optional AI Microservice
AI_SERVICE_URL=http://localhost:8001
AI_SERVICE_API_KEY=dev-ai-service-key

# Rate Limiting & Logs
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
LOG_LEVEL=info
